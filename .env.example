# Copy to .env and export, or set in your scheduler. All variables are optional.
LENS_TICKERS=AAPL,MSFT,BRK-B,KO,JNJ,PG,JPM,XOM
LENS_OUTPUT_PATH=market_intelligence_payload.md
LENS_LOG_LEVEL=INFO
# LENS_LOG_FILE=investor_lens.log

# Ingestion
LENS_DATA_SOURCE=yfinance          # yfinance | files
# LENS_DATA_DIR=data                # folder read by the files source
LENS_FETCH_DELAY_SECONDS=2
LENS_MAX_RETRIES=3
LENS_RISK_FREE_FALLBACK=0.04
LENS_BENCHMARK_TICKER=^GSPC          # Nifty 50: ^NSEI
LENS_RISK_FREE_TICKER=^TNX           # 'none' = always use LENS_RISK_FREE_FALLBACK
LENS_RISK_FREE_QUOTE_IN_PERCENT=true

# News (headlines are attached to the report; one extra request per ticker)
LENS_NEWS_ENABLED=true
LENS_NEWS_MAX_ITEMS=10

# Buffett DCF assumptions
LENS_EQUITY_RISK_PREMIUM=0.05
LENS_TERMINAL_GROWTH_CAP=0.025
LENS_DCF_YEARS=10
LENS_GROWTH_CAP=0.15
LENS_GROWTH_FLOOR=-0.10
